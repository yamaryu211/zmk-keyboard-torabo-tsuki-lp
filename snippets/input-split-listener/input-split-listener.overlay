/{
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        pointing_device_split: pointing_device_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    pointing_device_split_listener: pointing_device_split_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device_split>;
        status = "okay";
        /* デフォルト: Mac 方向（サブノードが一致しない場合のフォールバック） */
        input-processors = <&zip_xy_scaler 1 3>, <&zip_xy_to_scroll_mapper>;

        scroll_win {
            /* WIN_SCROLL_DIR (16): bt0_win で tog_on、bt1_mac 等で tog_off */
            layers = <16>;
            input-processors =
                <&zip_xy_scaler 3 2>,
                <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
                <&zip_xy_to_scroll_mapper>;
        };
    };
};
